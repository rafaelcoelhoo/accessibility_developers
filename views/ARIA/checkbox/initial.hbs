<div class="aria-checkbox">
    <h2>Choose some colors</h2>

    <div class="checkbox" >
        Green
    </div>
    <div class="checkbox" >
        Red
    </div>
    <div class="checkbox">
        White
    </div>

</div>

<script>

    (function () {
        const checkboxes = document.querySelectorAll('.checkbox');
        const toggleVisualState = checkbox => {
            const isChecked = checkbox.classList.toggle('is-checked');

            if (checkbox.hasAttribute('aria-checked')) {
                checkbox.setAttribute('aria-checked', isChecked ? 'true' : 'false');
            }
        };

        checkboxes.forEach(check => {

            // For mouse
            check.addEventListener('click', function () {
                toggleVisualState(this);
            });

   /*         // For keyboard

           check.addEventListener('keydown', function (e) {
                    if (e.key === ' ') e.preventDefault();
                });

            check.addEventListener('keyup', function (e) {
                e.preventDefault();
                e.stopPropagation();
                if (e.key === ' ') {
                    toggleVisualState(this);
                }
            });
             */
        })
       
    })()
</script>
